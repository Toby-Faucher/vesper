# Caddy terminates HTTPS on 443 and proxies to Vesper's HTTP port. WebSocket upgrades (/ws) work
# without extra config. Media does NOT go through Caddy: it is UDP 40000 straight to the server.
vesper.tfaucher.com {
	# Compress text assets only: the 15 MB DSP wasm and the model tarball under /dsp/ would be
	# recompressed on every load, which costs a small host real CPU for little gain.
	@compressible not path /dsp/*
	encode @compressible zstd gzip
	reverse_proxy 127.0.0.1:8080   # or vesper:8080 on a shared docker network

	# Optional hardening, UNTESTED against the real app (a wrong CSP silently breaks WASM, the audio
	# worklet or WebRTC). Try it in a browser with the console open before enabling:
	# header {
	#	Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' wss://vesper.tfaucher.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; object-src 'none'; base-uri 'none'"
	#	Strict-Transport-Security "max-age=31536000"
	#	Referrer-Policy "no-referrer"
	#	Permissions-Policy "microphone=(self)"
	# }
}
