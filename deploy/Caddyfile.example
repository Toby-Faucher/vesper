# Caddy terminates HTTPS on 443 and proxies to Vesper's HTTP port. WebSocket upgrades (/ws) work
# without extra config. Media does NOT go through Caddy: it is UDP 40000 straight to the server.
vesper.tfaucher.com {
	# Compress text assets only. Under /dsp/ Vesper already sends a gzip copy of the wasm, and the model
	# tarball is gzip itself: recompressing them on every load costs a small host real CPU for little gain.
	@compressible not path /dsp/*
	encode @compressible zstd gzip
	# Not verified with a real Caddy. By its documented defaults Caddy sets X-Forwarded-For to its own peer
	# (cloudflared) and passes Cloudflare's CF-Connecting-IP through unchanged; a global `trusted_proxies`
	# option changes the X-Forwarded-For handling; Vesper reads CF-Connecting-IP first (docs/deploy.md, Client address). Do not
	# strip or rewrite either header here.
	reverse_proxy 127.0.0.1:8080   # or vesper:8080 on a shared docker network

	# HSTS makes browsers refuse plain HTTP for this name for a year: keep it only once HTTPS works.
	# Vesper sends the same HSTS and its own CSP, Referrer-Policy, Permissions-Policy, COOP and nosniff
	# (docs/decisions/0008-csp.md): do not set those here. HSTS is kept here on purpose with the same value, so
	# it stays if the server's is lost; the browser then gets two identical copies, which is harmless.
	header Strict-Transport-Security "max-age=31536000"
}
