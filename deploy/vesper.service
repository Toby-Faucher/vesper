# Plain-binary install. Assumes: binary at /opt/vesper/vesper-server, web app (web/dist) at
# /opt/vesper/web (world-readable: DynamicUser has no group/owner access), and /etc/vesper/vesper.env containing (mode 600, owned by root):
#   VESPER_ORIGIN=https://vesper.tfaucher.com
#   VESPER_PUBLIC_HOST=vesper.tfaucher.com
# The database lives in /var/lib/vesper (StateDirectory; with DynamicUser it is really /var/lib/private/vesper).
[Unit]
Description=Vesper voice chat server
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
EnvironmentFile=/etc/vesper/vesper.env
Environment=VESPER_WEB_DIR=/opt/vesper/web
Environment=VESPER_DATA_DIR=/var/lib/vesper
StateDirectory=vesper
StateDirectoryMode=0700
Environment=VESPER_HTTP_BIND=127.0.0.1:8080
Environment=VESPER_UDP_BIND=0.0.0.0:40000
ExecStart=/opt/vesper/vesper-server
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
