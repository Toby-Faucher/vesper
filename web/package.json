{
  "name": "vesper-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "size": "node scripts/size-check.mjs",
    "ci": "npm run check && npm test && npm run build && npm run size",
    "e2e": "node e2e/two-browser.mjs && node e2e/flows.mjs",
    "shots": "node e2e/shots.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/svelte": "5.0.8",
    "animejs": "4.5.0",
    "playwright-core": "1.64.1",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
